ncia y el\nvalor en ohmios que debería tener.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"OfAvepzVZc"}],"key":"uVpTGPjRsP"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":62,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“222” -> 2K2","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"e7FFh0JLZk"}],"key":"M5mKGAXON6"}],"key":"EpJUzlegB3"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“151” -> 150","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"yZ2P8sfFRI"}],"key":"uVaRria2gO"}],"key":"cdkDnMsPfn"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“223” -> 22K","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"dDAY4vJTNH"}],"key":"qBC1gl0zuj"}],"key":"kDd8myiDeC"},{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“223” -> 22K","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"yoVzvduOaB"}],"key":"fvX7gYcsna"}],"key":"GmNYe9rr7T"},{"type":"listItem","spread":true,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"“2204” (225) -> 2M2","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"Tc1I2oHLAO"}],"key":"DmecO1y199"}],"key":"A0rCbHBqgs"},{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"